# =====================================================================
#  Sistem Kejohanan Futsal Merdeka Kepala Batas 2026
#  Tetapan pelayan Apache (cPanel)
# =====================================================================

# Jangan senaraikan kandungan folder
Options -Indexes

# Halaman utama
DirectoryIndex index.html

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# Fail statik (nama fail mengandungi hash) — boleh di-cache lama
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png             "access plus 1 month"
    ExpiresByType image/svg+xml         "access plus 1 month"
    ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

# Mampatan — muat turun lebih laju di talian mudah alih gelanggang
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Lindungi fail sensitif
<FilesMatch "^(config\.php|config\.local\.php|schema\.sql|\.env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
